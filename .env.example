# Supabase connection (REQUIRED for persistent accounts & logins; keep strictly on the server)
# Also supports NEXT_PUBLIC_SUPABASE_URL / VITE_SUPABASE_URL and SUPABASE_SERVICE_KEY / SUPABASE_SECRET_KEY
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# SESSION_SECRET: Required in production/Vercel so signed auth tokens stay valid across restarts and serverless instances.
# Generate a strong random string (e.g. openssl rand -hex 32).
SESSION_SECRET=""

# ALLOW_LOCAL_FALLBACK: Optional (default false). Set to "true" ONLY for local offline dev without Supabase.
ALLOW_LOCAL_FALLBACK="false"

# DATA_DIR: Optional custom writable directory when ALLOW_LOCAL_FALLBACK="true".
DATA_DIR=""

# APP_URL: Public URL where the app is hosted.
APP_URL=""
